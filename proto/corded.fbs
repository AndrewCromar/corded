// Corded wire protocol, prototype draft. Every frame on the wire is a
// 4-byte little-endian length followed by a FlatBuffers `Frame`.
namespace corded.wire;

table KeyEntry { id: uint32; key: [ubyte]; }
// is_admin: the owner, or anyone holding the administrator permission.
table Member { user_id: [ubyte]; username: string; is_admin: bool; is_owner: bool; roles: [uint32]; }
table Role { role_id: uint32; name: string; position: int32; permissions: uint64; is_everyone: bool; }
table Recipient { device_id: [ubyte]; ciphertext: [ubyte]; }
table Cursor { room_id: [ubyte]; seq: uint64; }

// ---- session ----
table Hello { protocol_version: uint16; server_name: string; challenge: [ubyte]; }
table Register {
  username: string;
  user_id: [ubyte];      // Ed25519 user identity public key
  device_id: [ubyte];    // Ed25519 device signing public key
  dh_key: [ubyte];       // X25519 device DH public key
  cert: [ubyte];         // user identity signature over (device_id, dh_key)
  signature: [ubyte];    // device signature over the challenge
  invite: string;        // required when the server is invite-only
}
table Authenticate { device_id: [ubyte]; signature: [ubyte]; }
table AuthOk { user_id: [ubyte]; username: string; server_ts: uint64; is_admin: bool; }
table Error { code: uint16; message: string; }
table Ok {}

// ---- keys ----
table PublishPrekeys { spk_id: uint32; spk: [ubyte]; spk_sig: [ubyte]; otks: [KeyEntry]; }
table FetchBundle { user_id: [ubyte]; }
table Bundle {
  user_id: [ubyte]; device_id: [ubyte]; dh_key: [ubyte]; cert: [ubyte];
  spk_id: uint32; spk: [ubyte]; spk_sig: [ubyte];
  has_otk: bool; otk_id: uint32; otk: [ubyte];
}
table LookupUser { username: string; }
table UserInfo { user_id: [ubyte]; username: string; }

// ---- rooms ----
table CreateRoom { members: [Member]; }   // only user_id is read
// kind: 0 = channel of the server, 1 = direct message, 2 = group. For a channel,
// `members` is everyone who can currently view it and `name` is its name.
table RoomInfo {
  room_id: [ubyte]; members: [Member]; created_at: uint64; is_direct: bool;
  kind: ubyte; name: string;
}
// Groups only. Any member may add someone; anyone may leave.
table AddMember { room_id: [ubyte]; user_id: [ubyte]; }
table LeaveRoom { room_id: [ubyte]; }

// ---- the community: one server is one community (see 04-community-model.md) ----
// Sent after sign-in and again whenever it changes.
table ServerInfo {
  name: string; owner: [ubyte]; my_permissions: uint64; roles: [Role];
  history_sharing: bool = true;   // whether newcomers may ask members for old messages
}
// A newcomer asks for messages from before they joined. The server holds none
// it can read, so it passes the request to members who are online; each of
// their clients decides whether to answer.
// ---- running the server from a client ----
table Setting { key: string; value: string; owner_only: bool; needs_restart: bool; description: string; }
table GetSettings {}
table Settings { entries: [Setting]; }
table SetSetting { key: string; value: string; }
table Restart {}                 // restart the server program (not the computer)
table GetStatus {}
table Status {
  version: string; started_at: uint64; members: uint32; online: uint32;
  stored_bytes: uint64; last_housekeeping: uint64; scope: string;
}
table Notice { message: string; }   // something the server wants members to read

table HistoryRequest { room_id: [ubyte]; limit: uint32; }
table HistoryWanted { room_id: [ubyte]; requester: [ubyte]; limit: uint32; }
table GetMembers {}
table MemberList { members: [Member]; }
table NewRole { name: string; permissions: uint64; }
table EditRole { role_id: uint32; name: string; permissions: uint64; }
table RemoveRole { role_id: uint32; }
table GrantRole { user_id: [ubyte]; role_id: uint32; assign: bool; }
table CreateChannel { name: string; }
table UpdateChannel { room_id: [ubyte]; name: string; }
table DeleteChannel { room_id: [ubyte]; }
// Per-channel exception for one role: bits in `allow` are granted there, bits in
// `deny` are taken away. Both zero removes the exception.
table SetOverride { room_id: [ubyte]; role_id: uint32; allow: uint64; deny: uint64; }
// Invites: a code that lets someone create an account on an invite-only server.
// max_uses 0 means unlimited; expires_in_s 0 means it never expires.
table NewInvite { max_uses: uint32; expires_in_s: uint64; }
table Invite { code: string; max_uses: uint32; expires_at: uint64; }
table RevokeInvite { code: string; }
table Kick { user_id: [ubyte]; }                      // remove from the server; may rejoin
table BanUser { user_id: [ubyte]; banned: bool; }     // a banned user cannot sign in
table ListRooms {}
table RoomList { rooms: [RoomInfo]; }

// ---- events ----
// expires_at (ms since epoch, 0 = never) is the one thing about a disappearing
// message the server is told, so that it can drop its stored copy on time.
table SendRoomEvent { room_id: [ubyte]; event_id: [ubyte]; recipients: [Recipient]; expires_at: uint64; }
table SendOk { room_id: [ubyte]; event_id: [ubyte]; seq: uint64; server_ts: uint64; }
table RoomEvent {
  room_id: [ubyte]; seq: uint64; event_id: [ubyte];
  sender_user: [ubyte]; sender_device: [ubyte]; server_ts: uint64;
  ciphertext: [ubyte];
}
table Sync { cursors: [Cursor]; }
table SyncComplete {}

union FrameBody {
  Hello, Register, Authenticate, AuthOk, Error, Ok,
  PublishPrekeys, FetchBundle, Bundle, LookupUser, UserInfo,
  CreateRoom, RoomInfo, ListRooms, RoomList,
  SendRoomEvent, SendOk, RoomEvent, Sync, SyncComplete,
  AddMember, LeaveRoom,
  BanUser, Kick, ServerInfo, GetMembers, MemberList,
  NewRole, EditRole, RemoveRole, GrantRole,
  CreateChannel, UpdateChannel, DeleteChannel, SetOverride,
  NewInvite, Invite, RevokeInvite,
  HistoryRequest, HistoryWanted,
  GetSettings, Settings, SetSetting, Restart, GetStatus, Status, Notice
}

table Frame { request_id: uint32; body: FrameBody; }

// ---- plaintext, only ever seen by clients (inside the encrypted payload) ----
table Relation { kind: string; target: [ubyte]; key: string; }
table Event {
  event_id: [ubyte];
  type: string;
  type_version: uint16;
  sender_user: [ubyte];
  sender_device: [ubyte];
  origin_ts: uint64;
  relation: Relation;
  state_key: string;
  content_encoding: ubyte;   // 0 = JSON
  content: [ubyte];
  fallback_text: string;
  expires_at: uint64;
}

root_type Frame;
